flowchart LR

%% =====================
%% Styles
%% =====================
classDef cmd fill:#ffffff,stroke:#111111,stroke-width:2px,color:#111111;
classDef file fill:#eef4ff,stroke:#3366cc,stroke-width:1.5px,color:#2244aa;
classDef opt fill:#f3fff1,stroke:#4c9a2a,stroke-width:1.5px,color:#2f6f1e;

%% =====================
%% Annotate
%% =====================
annotate_opts["
    -p, --prodigal_procedure XXX
    --norna
    --allow-overlap
    --kingdom XXX
    --use-pseudo
"]:::opt -.-> annotate
anno[(genomes.gbff list)]:::file -."--anno".-> annotate[annotate]:::cmd
fasta[(genomes.fasta.list)]:::file -."--fasta".-> annotate

%% =====================
%% Cluster
%% =====================
cluster_opts["
    --identity 0.8
    --coverage 0.8
    --mode 1/2/3
    --infer_singleton
    --no_defrag
"]:::opt -.-> cluster
clusters_tsv[clusters.tsv]:::file -."--clusters".-> cluster
annotate ==> cluster[cluster]:::cmd

%% =====================
%% Graph
%% =====================
graph_opts["
    --remove_high_copy_number X
"]:::opt -.-> graf
cluster ==> graf[graph]:::cmd

%% =====================
%% Partition
%% =====================
partition_opts["
    -K, --nb_of_partitions X
"]:::opt -.-> partition
graf ==> partition[partition]:::cmd

%% =====================
%% RGP
%% =====================
rgp_opts["
    --variable_gain
    --persistent_penalty
    --min_score
    --min_length
    --dup_margin 0.05
"]:::opt -.-> rgp
partition ==> rgp[rgp]:::cmd

%% rgpclust_opts["
%%     --grr_cutoff 0.8
%%     --no_identical_rgp_merging
%% "]:::opt -.-> rgp_clust
%% rgp ==> rgp_clust[rgp_clust]:::cmd
%% rgp_clust --> clust["rgp_clusters.tsv"]:::file
%% rgp_clust --> cgexf["rgp_clusters.gexf"]:::file

%% =====================
%% Spot
%% =====================
spot_opts["
    --set_size 3
    --overlapping_match 2
    --exact_match_size 1
    --spot_graph
    --graph_formats gexf
"]:::opt -.-> spot
rgp ==> spot[spot]:::cmd

%% =====================
%% Module
%% =====================
module[module]:::cmd
partition ==> module

%% =====================
%% Pangenome.h5 Output
%% =====================
module --> h5[(pangenome.h5)]:::file
spot --> h5
%% rgp_clust ~~~ h5
rgp --> h5
partition --> h5
graf --> h5
cluster --> h5
annotate --> h5

%% =====================
%% Rarefaction
%% =====================
rarefaction_opts["
    --depth 30
    --min 1
    --max 100
"]:::opt -.-> rarefaction
h5 --"-p"--> rarefaction[rarefaction]:::cmd
rarefaction --> rare["rarefaction.html"]:::file

%% =====================
%% Draw
%% =====================
draw_opts["
    --nocloud
    --add_dendrogram
    --add_metadata
"]:::opt -.-> draw
h5 --"-p"--> draw[draw]:::cmd

%% == Workflow ==
draw -."--ucurve".-> uplot["Ushaped_plot.html"]:::file
draw -."
    --tile_plot
    ? --nocloud
    ? --add_dendrogram
    ? --add_metadata
".-> tile["tile_plot.html"]:::file
tile ~~~ uplot

%% == PanRGP ==
draw -."
    --draw_spots
    --spots
".-> spot_fig["spot_figures"]:::file
spot_fig --> sgexf["spot_X.gexf"]:::file
spot_fig --> shtml["spot_X.html"]:::file
spot_fig --> siden["spot_X_identical_rgps.tsv"]:::file

%% =====================
%% Metrics
%% =====================
h5 --"-p"--> metrics[metrics]:::cmd
metrics -."--genome_fluidity".-> h5

%% =====================
%% Write Pangenome
%% =====================
h5 --"-p"--> wp[write_pangenome]:::cmd
wp_opts["
    -o --output XXX
"]:::opt -.-> wp

%% == Workflow ==
wp -."--families_tsv".-> families["gene_families.tsv"]:::file
wp -."--Rtab".-> rtab["gene_presence_absence.Rtab"]:::file
wp -."--stats".-> stats["genome_statistics.tsv"]:::file
wp -."
    --stats
    -- dup_margin 0.05
".-> dup["mean_persistent_duplication.tsv"]:::file
wp -."--csv".-> csv["matrix.csv"]:::file
wp -."--gexf".-> gexf["pangenomeGraph.gexf"]:::file
wp -."--light_gexf".-> lgexf["pangenomeGraph_light.gexf"]:::file
wp -."--json".-> json["pangenomeGraph.json"]:::file
wp -."--partitions".-> partitions["partition/XXX.txt"]:::file
dup ~~~ stats
families & rtab ~~~ csv & partitions
lgexf & json ~~~ gexf

%% == PanRGP ==
wp -."--regions".-> regions["regions_of_genomic_plasticity.tsv"]:::file
wp -."--spots".-> spots_tsv["spots.tsv"]:::file
wp -."--spots".-> spots_sum["summarize_spots.tsv"]:::file
wp -."--borders".-> spot_borders["spot_borders.tsv"]:::file
wp -."--borders".-> border_genes["border_protein_genes.fasta"]:::file
spots_tsv ~~~ spots_sum
spot_borders ~~~ border_genes
wp -."--regions_families".-> reg_fam["rgp_families.tsv"]:::file
regions ~~~ reg_fam

%% == PanModule ==
wp -."--module".-> mfun["functional_modules.tsv"]:::file
wp -."--module".-> mgen["modules_in_genomes.tsv"]:::file
wp -."--module".-> msum["modules_summary.tsv"]:::file
mfun & mgen ~~~ msum
wp -."--spot_modules".-> mspot["modules_spots.tsv"]:::file
wp -."--spot_modules".-> mrgpl["modules_RGP_lists.tsv"]:::file
mrgpl ~~~ mspot

%% =====================
%% Write Genomes
%% =====================
h5 --"-p"--> wg[write_genomes]:::cmd
wg_opts["
    --add_metadata
"]:::opt -.-> wg
%% anno -."--anno".-> wg
%% fasta -."--fasta".-> wg
wg -."--proksee".-> proksee["proksee/XXX.json"]:::file
wg -."--gff".-> gff["gff/XXX.gff"]:::file
wg -."--table".-> table["table/XXX.tsv"]:::file
table & proksee ~~~ gff

%% =====================
%% Info
%% =====================
h5 --"-p"--> info[info]:::cmd
info_opts["
    --status
    --parameters
    --content
    --metadata
"]:::opt -.-> info
