flowchart LR

%% =====================
%% Styles
%% =====================
classDef cmd fill:#ffffff,stroke:#111111,stroke-width:2px,color:#111111;
classDef file fill:#eef4ff,stroke:#3366cc,stroke-width:1.5px,color:#2244aa;
classDef opt fill:#f3fff1,stroke:#4c9a2a,stroke-width:1.5px,color:#2f6f1e;

%% =====================
%% Annotate
%% =====================
annotate_opts["
    -p --prodigal
    --norna
    --allow-overlap
    --kingdom XXX
    --use-pseudo
"]:::opt -.-> annotate
anno[(genomes.gbff list)]:::file -."--anno".-> annotate[annotate]:::cmd
fasta[(genomes.fasta.list)]:::file --"--fasta"--> annotate

%% =====================
%% Cluster
%% =====================
cluster_opts["
    --identity 0.8
    --coverage 0.8
    --mode 1/2/3
    --infer_singleton
    --no_defrag
"]:::opt -.-> cluster
clusters_tsv[clusters.tsv]:::file -."--clusters".-> cluster
annotate ==> cluster[cluster]:::cmd

%% =====================
%% Graph
%% =====================
graph_opts["
    --remove_high_copy_number
"]:::opt -.-> graf
cluster ==> graf[graph]:::cmd

%% =====================
%% Partition
%% =====================
partition_opts["
    --nb_of_partitions X
"]:::opt -.-> partition
graf ==> partition[partition]:::cmd

%% =====================
%% RGP
%% =====================
rgp_opts["
    --variable_gain
    --persistent_penalty
    --min_score
    --min_length
    --dup_margin
"]:::opt -.-> rgp
partition ==> rgp[rgp]:::cmd

%% =====================
%% Spot
%% =====================
spot_opts["
    --set_size
    --overlapping_match
    --exact_match_size
    --spot_graph
    --graph_formats
"]:::opt -.-> spot
rgp ==> spot[spot]:::cmd

%% =====================
%% Module
%% =====================
module[module]:::cmd
partition ==> module

%% =====================
%% Pangenome.h5 Output
%% =====================
module --> h5[(pangenome.h5)]:::file
spot --> h5
rgp --> h5
partition --> h5
graf --> h5
cluster --> h5
annotate --> h5

%% =====================
%% Draw
%% =====================
draw_opts["
    --nocloud
    --add_dendrogram
    --add_metadata
"]:::opt -.-> draw
h5 --"-p"--> draw[draw]:::cmd

draw -."--ucurve".-> uplot["uplot.html"]:::file
draw -."--tile_plot".-> tile["tile_plot.html"]:::file

%% =====================
%% Rarefaction
%% =====================
rarefaction_opts["
    --depth 30
    --min 1
    --max 100
"]:::opt -.-> rarefaction
h5 --"-p"--> rarefaction[rarefaction]:::cmd

rarefaction --> rare["rarefaction.html"]:::file

%% =====================
%% Metrics
%% =====================
h5 --"-p"--> metrics[metrics]:::cmd
metrics -."--genome_fluidity".-> h5

%% =====================
%% Write Pangenome
%% =====================
h5 --"-p"--> wp[write_pangenome]:::cmd
wp_opts["
    -o rgp_outputs
"]:::opt -.-> wp
wp -."--stats".-> stats["genome_statistics.tsv"]:::file
wp -."
    --stats
    -- dup_margin 0.05
".-> dup["mean_persistent_duplication.tsv"]:::file
wp -."--partitions".-> partitions["partition/XXX.txt"]:::file
wp -."--gexf".-> gexf["XXX.gexf"]:::file
wp -."--light_gexf".-> lgexf["XXX_light.gexf"]:::file
wp -."--json".-> json["XXX.json"]:::file
gexf & json ~~~ lgexf
wp -."--families_tsv".-> families["gene_families.tsv"]:::file
wp -."--regions".-> regions["regions_of_genomic_plasticity.tsv"]:::file
wp -."--regions_families".-> rgp_fam["rgp_families.tsv"]:::file
families & regions ~~~ rgp_fam
wp -."--spots".-> spots["spots.tsv"]:::file & sum["summarize_spots.tsv"]:::file
spots ~~~ sum
wp -."--border".-> border["border.tsv"]:::file & border_fasta["border_protein_genes.fasta"]:::file
border ~~~ border_fasta

%% =====================
%% Info
%% =====================
h5 --"-p"--> info[info]:::cmd
info_opts["
    --status
    --parameters
    --content
    --metadata
"]:::opt -.-> info
